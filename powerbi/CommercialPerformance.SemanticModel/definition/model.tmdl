ref table dim_plan_type
ref table dim_district
ref table dim_region
ref table dim_channel
ref table dim_segment
ref table dim_date
ref table fact_budget
ref table fact_revenue_bridge
ref table dim_bridge_component
ref table fact_initiative_assignment
ref table dim_initiative
ref table fact_network_district_month
ref table recon_summary
ref table controls_log
ref table plan_price_history
ref table _Measures
ref table metric_definitions

ref cultureInfo en-US

