table dim_district
	lineageTag: d9147f42-2f79-40a8-bc43-b356b603c026

	column district_id
		dataType: int64
		isHidden
		lineageTag: 37ba159a-146e-401e-a8be-978f58e37e86
		summarizeBy: none
		sourceColumn: district_id

	column district
		dataType: string
		lineageTag: 74998597-3411-40e4-8213-b574968911ac
		summarizeBy: none
		sourceColumn: district

	column region_id
		dataType: int64
		isHidden
		lineageTag: 120f01f7-4c88-44ec-8afa-4282fb11ef52
		summarizeBy: none
		sourceColumn: region_id

	partition dim_district = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_district.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"district_id", Int64.Type}, {"district", type text}, {"region_id", Int64.Type}}, "en-US")
				in
				    Typed

