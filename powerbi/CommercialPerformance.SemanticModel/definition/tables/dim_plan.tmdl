	partition dim_plan = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_plan.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"plan_id", type text}, {"plan_name", type text}, {"plan_type", type text}, {"monthly_fee", type number}, {"plan_sort", Int64.Type}}, "en-US")
				in
				    Typed

