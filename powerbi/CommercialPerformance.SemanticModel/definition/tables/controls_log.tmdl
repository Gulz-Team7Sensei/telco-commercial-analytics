	partition controls_log = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\controls_log.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"check_id", type text}, {"description", type text}, {"months_affected", type text}, {"rows_affected", Int64.Type}, {"net_revenue_impact", type number}, {"action_taken", type text}, {"status", type text}}, "en-US")
				in
				    Typed

