	partition dim_initiative = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_initiative.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"initiative_id", type text}, {"initiative_name", type text}, {"launch_month", type date}, {"end_month", type date}, {"baseline_start", type date}, {"baseline_end", type date}, {"target_description", type text}, {"offer_description", type text}}, "en-US")
				in
				    Typed

