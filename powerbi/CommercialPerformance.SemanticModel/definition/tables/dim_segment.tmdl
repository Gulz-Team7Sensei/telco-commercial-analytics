table dim_segment
	lineageTag: b88d8f85-e0e4-4a11-9db6-e330f9de6eeb

	column segment_id
		dataType: int64
		isHidden
		lineageTag: d4921248-bdee-4054-96e5-206fa214784e
		summarizeBy: none
		sourceColumn: segment_id

	column segment
		dataType: string
		lineageTag: bf7732f6-5940-407b-afb9-7f41ce765d6e
		summarizeBy: none
		sourceColumn: segment

	partition dim_segment = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_segment.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"segment_id", Int64.Type}, {"segment", type text}}, "en-US")
				in
				    Typed

